# Copy to homolog.tfvars and replace every placeholder with IDs from the
# Kubernetes/network infrastructure repository. This file contains no secrets.
aws_region   = "us-east-1"
project_name = "oficina"
environment  = "homolog"

vpc_id = "vpc-0123456789abcdef0"
private_subnet_ids = [
  "subnet-0123456789abcdef0",
  "subnet-0fedcba9876543210",
]

# Workload SGs only; for example, the Lambda authentication SG and EKS workload
# SG. They reach only RDS Proxy; the database accepts only the Proxy SG.
allowed_security_group_ids = [
  "sg-0123456789abcdef0",
]

db_name        = "oficina"
db_username    = "oficina_admin"
engine_version = "16"
instance_class = "db.t4g.micro"

allocated_storage     = 20
max_allocated_storage = 100
multi_az               = false

backup_retention_period = 7
deletion_protection      = false
skip_final_snapshot      = true
delete_automated_backups = true

performance_insights_retention_period = 7
monitoring_interval                   = 60
cloudwatch_log_retention_days         = 30
secret_recovery_window_in_days        = 7

tags = {
  CostCenter = "tech-challenge"
  Owner      = "soat-architecture"
}
