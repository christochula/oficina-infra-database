# Copy to prod.tfvars and replace every placeholder with production network
# IDs. Production safety preconditions enforce Multi-AZ, deletion protection,
# final snapshots and at least seven days of PITR retention.
aws_region   = "us-east-1"
project_name = "oficina"
environment  = "production"

vpc_id = "vpc-0123456789abcdef0"
private_subnet_ids = [
  "subnet-0123456789abcdef0",
  "subnet-0fedcba9876543210",
  "subnet-00112233445566778",
]

# Workload SGs only. They reach RDS Proxy; RDS accepts only the Proxy SG.
allowed_security_group_ids = [
  "sg-0123456789abcdef0",
  "sg-0fedcba9876543210",
]

db_name        = "oficina"
db_username    = "oficina_admin"
engine_version = "16"
instance_class = "db.t4g.small"

allocated_storage     = 100
max_allocated_storage = 1000
multi_az               = true

backup_retention_period = 35
deletion_protection      = true
skip_final_snapshot      = false
delete_automated_backups = false

performance_insights_retention_period = 7
monitoring_interval                   = 60
cloudwatch_log_retention_days         = 90
secret_recovery_window_in_days        = 30

tags = {
  CostCenter   = "tech-challenge"
  Owner        = "soat-architecture"
  Criticality  = "high"
}
