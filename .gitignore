# Terraform working directory and dependency cache
.terraform/
.terraformrc
terraform.rc

# State and lock artifacts (remote S3 state is mandatory)
*.tfstate
*.tfstate.*
*.tflock

# Plans can contain sensitive values
*.tfplan
tfplan
plan.txt

# Real environment/backend files are local or generated by CI. Examples remain tracked.
*.tfvars
!*.tfvars.example
*.tfvars.json
!*.tfvars.json.example
*.tfbackend
!*.tfbackend.example

# Crash and override files
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local credentials and editor/OS files
.env
.env.*
!.env.example
.idea/
.vscode/
.DS_Store
Thumbs.db
